<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <RootNamespace>Pager.Duty.Webhooks</RootNamespace>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <IncludeSource>true</IncludeSource>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);IDE0290;CS8509</NoWarn>

        <Version>$(ProjectVersion)</Version>
        <Title>PagerDuty.Webhooks</Title>
        <PackageId>PagerDuty.Webhooks</PackageId>
        <Product>PagerDuty.Webhooks</Product>
        <Description>Receive PagerDuty incident updates by receiving Webhooks V3 requests using ASP.NET Core.</Description>
        <Authors>Ben Hutchison</Authors>
        <Company>$(Authors)</Company>
        <Copyright>© 2025 $(Authors)</Copyright>
        <RepositoryUrl>https://github.com/Aldaviva/PagerDuty.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>pagerduty webhook</PackageTags>
        <PackageProjectUrl>https://github.com/Aldaviva/PagerDuty</PackageProjectUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageIcon>icon.png</PackageIcon>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <PackageReadmeFile>Readme.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <AdditionalFiles Include="..\PagerDuty\ExceptionAdjustments.txt" />
        <InternalsVisibleTo Include="Tests;Test.Webhooks" />
        <None Include="..\PagerDuty\icon.png;..\Readme.md" Pack="true" PackagePath="\" />
        <None Include="..\.github*\**" Visible="true" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    </ItemGroup>
    
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    
    <Choose>
        <When Condition="'$(Configuration)' != 'Debug'">
            <ItemGroup>
                <PackageReference Include="PagerDuty" Version="$(ProjectVersion)" />
            </ItemGroup>
        </When>
        <Otherwise>
            <ItemGroup>
                <ProjectReference Include="..\PagerDuty\PagerDuty.csproj" />
            </ItemGroup>
        </Otherwise>
    </Choose>

    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' or '$(Configuration)' != 'Debug'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

</Project>